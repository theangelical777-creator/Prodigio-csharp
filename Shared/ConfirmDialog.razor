@if (Visible)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <div class="modal-icon">
                <i class="ph ph-warning-octagon"></i>
            </div>
            <h3>@Title</h3>
            <p>@Message</p>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="Cancel">Cancelar</button>
                <button class="btn btn-danger" @onclick="Confirm">Eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Confirmar eliminación";
    [Parameter] public string Message { get; set; } = "¿Está seguro de que desea eliminar este elemento? Esta acción no se puede deshacer.";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync();
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}
