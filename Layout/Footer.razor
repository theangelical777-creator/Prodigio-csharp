<footer class="site-footer">

    <!-- Newsletter Band -->
    <div class="newsletter-band">
        <div class="newsletter-inner">
            <div class="newsletter-text">
                <h3>Recibe las mejores ofertas en tu correo</h3>
                <p>Suscríbete para descuentos exclusivos y notificaciones de nuevo stock.</p>
            </div>
            <div class="newsletter-form">
                @if (subscribed)
                {
                    <span class="badge-subscribed"><i class="ph ph-check-circle"></i> ¡Suscrito con éxito!</span>
                }
                else
                {
                    <input type="email" class="newsletter-input" placeholder="tu@correo.com" @bind="email" />
                    <button class="newsletter-button" @onclick="Subscribe">
                        Suscribirme
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- 3-Column Footer Layout matching User Reference -->
    <div class="footer-grid-3">

        <!-- Column 1: Enlaces del sitio -->
        <div class="footer-col-3">
            <h3 class="footer-title">Enlaces del sitio</h3>
            <div class="footer-links-subgrid">
                <ul class="footer-link-list">
                    <li><a href="">• INICIO</a></li>
                    <li><a href="cotizador">• AFILIADOS</a></li>
                </ul>
                <ul class="footer-link-list">
                    <li><a href="tienda">• TIENDA</a></li>
                    <li><a href="contacto">• CONTACTOS</a></li>
                </ul>
            </div>
        </div>

        <!-- Column 2: Visítanos CON MAPA -->
        <div class="footer-col-3">
            <h3 class="footer-title">Visítanos</h3>
            <p class="footer-address-text">
                Av. San Vicente #303, Megacentro.<br />
                Atención Lun–Vie 8am–5pm · Dom 9am–1pm.
            </p>
            
            <!-- MAPA INCRUSTADO -->
            <div class="footer-map-container">
                <iframe 
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3785.9215447547093!2d-69.95161!3d18.47396!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8eb1d0b3a3a3a3a3%3A0x8eb1d0b3a3a3a3a3!2sMegacentro!5e0!3m2!1ses!2sdo!4v1627000000000" 
                    width="100%" 
                    height="250" 
                    style="border:0; border-radius: 8px;" 
                    allowfullscreen="" 
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
            
            <div class="footer-btn-group">
                <a href="https://maps.google.com/?q=Megacentro+Santo+Domingo" target="_blank" class="footer-action-btn primary">
                    Cómo llegar <i class="ph ph-navigation-arrow"></i>
                </a>
                <a href="login" class="footer-action-btn secondary">
                    Panel Administrativo
                </a>
            </div>
        </div>

