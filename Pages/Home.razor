@page "/"

<PageTitle>Prodigio Tecnológico – Tienda de Telefonía Celular en Santo Domingo</PageTitle>

<!-- ── HERO ───────────────────────────────────────────── -->
<section class="hero page-offset">
    <div class="hero-grid">

        <div class="hero-content fade-in-up">
            <p class="hero-eyebrow">Tu tienda de confianza en Santo Domingo</p>
            <h1 class="hero-title">
                El mejor smartphone<br/>
                <span class="hero-title-brand">al mejor precio.</span>
            </h1>
            <p class="hero-desc">
                Venta de celulares nuevos y seminuevos certificados Grado A+, con <strong>1 año de garantía escrita</strong> y financiamiento Fiao desde el 20% de inicial.
            </p>

            <div class="hero-actions">
                <a href="/tienda" class="btn btn-primary btn-lg">
                    <i class="ph ph-shopping-bag"></i> Ver Catálogo Completo
                </a>
                <a href="/cotizador" class="btn btn-outline btn-lg">
                    <i class="ph ph-calculator"></i> Calcular Cuota
                </a>
            </div>

            <div class="hero-trust-strip">
                <div class="trust-item">
                    <span class="trust-icon">✓</span> Garantía 12 Meses
                </div>
                <div class="trust-item">
                    <span class="trust-icon">💳</span> Inicial desde 20%
                </div>
                <div class="trust-item">
                    <span class="trust-icon">🚚</span> Envío Gratis 24h
                </div>
                <div class="trust-item">
                    <span class="trust-icon">🔄</span> Trade-In
                </div>
            </div>
        </div>

        <div class="hero-visual">
            <div class="hero-phone-card">
                <img src="/iphone15promax.png" alt="iPhone 15 Pro Max" class="hero-phone-img float-anim" />
                <div class="hero-float-badge hero-badge-tl">
                    <div class="hero-badge-icon badge-icon-green">🎁</div>
                    <div>
                        <div style="font-size:12px; font-weight:800; color:var(--text-900);">AirPods Pro Incluidos</div>
                        <div style="font-size:11px; color:var(--text-500); font-weight:500;">Con cada iPhone 15 Pro</div>
                    </div>
                </div>
                <div class="hero-float-badge hero-badge-br">
                    <div class="hero-badge-icon badge-icon-blue">⭐</div>
                    <div>
                        <div style="font-size:12px; font-weight:800; color:var(--text-900);">Grado A+ Certificado</div>
                        <div style="font-size:11px; color:var(--text-500); font-weight:500;">40 pruebas técnicas</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- ── STATS BAR ───────────────────────────────────────── -->
<div class="stats-bar">
    <div class="stats-bar-grid">
        <div class="stat-item">
            <div class="stat-num">+3,500</div>
            <div class="stat-lbl">Equipos vendidos en RD</div>
        </div>
        <div class="stat-item">
            <div class="stat-num">12 Meses</div>
            <div class="stat-lbl">Garantía escrita en cada equipo</div>
        </div>
        <div class="stat-item">
            <div class="stat-num">30 min</div>
            <div class="stat-lbl">Tiempo de reparación express</div>
        </div>
        <div class="stat-item">
            <div class="stat-num">98%</div>
            <div class="stat-lbl">Clientes satisfechos (Google)</div>
        </div>
    </div>
</div>

<!-- ── ABOUT / QUIÉNES SOMOS ─────────────────────────── -->
<section class="about-section">
    <div class="section-inner">
        <div class="about-grid">

            <div class="about-img-wrap">
                <img src="/catalog_store.png" alt="Tienda Prodigio Tecnológico" class="about-img" />
                <div class="about-stat-card">
                    <div class="about-stat-num">2019</div>
                    <div class="about-stat-label">Fundada en Santo Domingo, RD</div>
                </div>
            </div>

            <div>
                <span class="section-label">Quiénes Somos</span>
                <h2 class="section-title">Donde tú eres el valor.</h2>
                <p class="section-subtitle mb-6">
                    Somos una <strong>tienda dominicana de telefonía celular</strong> especializada en la comercialización de smartphones (Apple, Samsung, Xiaomi, Tecno, Infinix y Motorola), servicio técnico avanzado y el mejor programa de Trade-In de Santo Domingo.
                </p>
                <p class="section-subtitle mb-8">
                    Cada equipo seminuevo que vendemos pasa por 40 pruebas técnicas de certificación para garantizar batería óptima, pantalla 100% funcional y estética impecable.
                </p>

                <div class="about-features">
                    <div class="feature-row">
                        <div class="feature-icon icon-blue"><i class="ph ph-storefront"></i></div>
                        <div class="feature-text">
                            <h4>Tienda Física en Santo Domingo</h4>
                            <p>Av. San Vicente #303, Megacentro. Atención Lun–Vie 8am–5pm · Dom 9am–1pm.</p>
                        </div>
                    </div>
                    <div class="feature-row">
                        <div class="feature-icon icon-mint"><i class="ph ph-shield-check"></i></div>
                        <div class="feature-text">
                            <h4>Respaldo Técnico con Garantía Escrita</h4>
                            <p>Certificado físico de garantía de 12 meses. Sin letra pequeña, sin cargos escondidos.</p>
                        </div>
                    </div>
                    <div class="feature-row">
                        <div class="feature-icon icon-lav"><i class="ph ph-credit-card"></i></div>
                        <div class="feature-text">
                            <h4>Financiamiento Fiao Flexible</h4>
                            <p>Aprobación inmediata solo con cédula. Cuotas quincenales o mensuales cómodas.</p>
                        </div>
                    </div>
                </div>

                <div class="flex gap-3 mt-8">
                    <a href="/nosotros" class="btn btn-primary">Conocer más →</a>
                    <a href="/contacto" class="btn btn-outline">Contactarnos</a>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ── PRODUCTS HIGHLIGHT ─────────────────────────────── -->
<section class="catalog-section">
    <div class="section-inner">
        <div class="section-header-block center">
            <span class="section-label">Catálogo Destacado</span>
            <h2 class="section-title">Smartphones más populares</h2>
            <p class="section-subtitle center">Equipos certificados Grado A+ con garantía, cargador original y funda de regalo.</p>
        </div>

        <div class="brand-chips mb-6" style="justify-content:center;">
            @foreach (var m in marcas)
            {
                <button class="brand-chip @(activeMarca == m ? "active" : "")" @onclick="() => { activeMarca = m; }">@m</button>
            }
        </div>

        <div class="products-grid">
            @foreach (var p in FiltradoHome)
            {
                <div class="product-card fade-in-up">
                    <div class="product-img-wrap">
                        <div class="product-badges">
                            <span class="badge-stock">✓ En Stock</span>
                            <span class="badge-cond">@p.Estado</span>
                        </div>
                        <img src="@p.Imagen" alt="@p.Modelo" class="product-img" />
                    </div>
                    <div class="product-body">
                        <p class="product-brand">@p.Marca</p>
                        <h3 class="product-name">@p.Modelo</h3>
                        <p class="product-specs"><i class="ph ph-hard-drive"></i> @p.Cap · @p.Color</p>
                        <div class="financing-pill">
                            <i class="ph ph-credit-card"></i> Cuota desde <strong>$@((p.Precio * .1m).ToString("N0")) RD$/mes</strong>
                        </div>
                        <div class="price-block">
                            <span class="price-old">$@((p.Precio * 1.1m).ToString("N0")) RD$</span>
                            <span class="price-main">$@p.Precio.ToString("N0") RD$</span>
                        </div>
                        <div class="product-actions">
                            <a href="https://wa.me/18095550199?text=Hola,%20me%20interesa%20el%20@Uri.EscapeDataString(p.Modelo)"
                               target="_blank" class="btn btn-wa btn-sm">
                                <i class="ph ph-whatsapp-logo"></i> Comprar por WA
                            </a>
                            <a href="/cotizador" class="btn btn-outline btn-sm">Cotizar cuota</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-10">
            <a href="/tienda" class="btn btn-primary btn-lg">
                Ver todos los productos en la Tienda <i class="ph ph-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- ── SERVICES ───────────────────────────────────────── -->
<section class="services-section">
    <div class="section-inner">
        <div class="section-header-block center">
            <span class="section-label">Lo que nos diferencia</span>
            <h2 class="section-title">Servicios Exclusivos</h2>
            <p class="section-subtitle center">Más que una tienda: somos tu socio tecnológico de confianza.</p>
        </div>
        <div class="services-grid">
            <!-- INTERCAMBIO / Trade-In -->
            <div class="service-card">
                <div class="service-icon s-blue">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                        <path d="M7.5 21.5L2 16l5.5-5.5 1.06 1.06-3.69 3.69H17v1.5H4.87l3.69 3.69L7.5 21.5zm9-13L15.44 7.44l3.69-3.69H7V2.25h12.13l-3.69-3.69L16.5 2.5 22 8l-5.5 5.5z"/>
                    </svg>
                </div>
                <h4>Entrega tu equipo usado</h4>
                <p>Entrega tu equipo usado como parte de pago por otro. Evaluamos su estado y te ofrecemos un valor justo.</p>
            </div>
            <!-- GARANTÍA -->
            <div class="service-card">
                <div class="service-icon s-mint">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1.5 13.5l-3-3 1.06-1.06 1.94 1.93 4.94-4.93 1.06 1.06-6 6z"/>
                    </svg>
                </div>
                <h4>Garantía Escrita 12 Meses</h4>
                <p>Certificado físico de garantía en hardware y software. Sin letra pequeña, sin cargos ocultos.</p>
            </div>
            <!-- INTERCAMBIO + BONO -->
            <div class="service-card">
                <div class="service-icon s-lav">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                        <path d="M20 6h-2.18c.07-.31.18-.62.18-.97C18 3.36 16.64 2 15 2c-.95 0-1.78.42-2.37 1.07L12 3.77l-.63-.7C10.78 2.42 9.95 2 9 2 7.36 2 6 3.36 6 5.03c0 .35.11.66.18.97H4c-1.11 0-2 .89-2 2v13c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zM15 4c.55 0 1 .45 1 1.03 0 .55-.45.97-1 .97h-3.56l.64-.71C12.42 4.71 12.97 4 15 4zM9 4c2.03 0 2.58.71 2.92 1.29L12.56 6H9c-.55 0-1-.42-1-.97C8 4.45 8.45 4 9 4zm11 17H4V13h16v8zm0-10H4V8h5.08L7 10.25l1.52.77L11 7.33l1 1.84 1-1.84 2.48 3.69L17 10.25 14.92 8H20v3z"/>
                    </svg>
                </div>
                <h4>Intercambio + Bono $2,000</h4>
                <p>Entrega tu equipo usado y recibe la mejor tasación del mercado más $2,000 RD$ de bono extra.</p>
            </div>
            <!-- ENVÍO -->
            <div class="service-card">
                <div class="service-icon s-amber">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                        <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-.5 1.5 1.96 2.5H17V9.5h2.5zM6 18c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2.22-3c-.55-.61-1.33-1-2.22-1s-1.67.39-2.22 1H3V6h12v9H8.22zM18 18c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
                    </svg>
                </div>
                <h4>Envío Gratis en 24 Horas</h4>
                <p>Entrega a domicilio en Santo Domingo y envíos seguros a todo el país sin costo adicional.</p>
            </div>
        </div>
    </div>
</section>

@code {
    private string activeMarca = "Todas";
    private List<string> marcas = new() { "Todas", "iPhone", "Samsung", "Xiaomi", "Tecno", "Infinix", "Motorola", "Honor" };

    public record Producto(string Marca, string Modelo, string Cap, string Color, string Estado, decimal Precio, string Imagen);

    private List<Producto> lista = new()
    {
        new("iPhone",  "iPhone 15 Pro Max",      "256 GB", "Titanio Natural", "Como Nuevo", 62500, "/iphone15promax.png"),
        new("Samsung", "Galaxy S24 Ultra",       "512 GB", "Titanium Gray",   "Sellado",    68000, "/s24ultra.png"),
        new("Motorola","Motorola Edge+ 2023",    "512 GB", "Interstellar Black","Sellado",  41500, "/motorolaedge.png"),
        new("Honor",   "HONOR Magic8 Lite",      "256 GB", "Verde Esmeralda",  "Sellado",   17500, "/honormagic.png"),
        new("Xiaomi",  "Redmi Note 13 Pro+",     "256 GB", "Blanco Aurora",   "Sellado",    19800, "/redminote13.png"),
        new("Infinix", "Infinix Note 40 Pro 5G", "256 GB", "Vintage Green",   "Sellado",    16500, "/infinixnote40.png"),
        new("Tecno",   "Tecno Camon 30 Pro 5G",  "256 GB", "Snowy White",     "Sellado",    18500, "/tecnocamon30.png"),
        new("Tecno",   "Tecno Spark 20 Pro+",    "256 GB", "Temporal Orbits", "Sellado",    13900, "/tecnospark20.png"),
    };

    private IEnumerable<Producto> FiltradoHome =>
        activeMarca == "Todas" ? lista : lista.Where(p => p.Marca == activeMarca);
}
