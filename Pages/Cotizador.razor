@page "/cotizador"
@page "/calculadora"
@page "/financiamiento"

@inject IJSRuntime JsRuntime

<PageTitle>Calculadora de Cuotas Fiao – Prodigio Tecnológico</PageTitle>

<!-- PAGE HERO -->
<div class="catalog-hero-band page-offset">
    <div class="catalog-hero-inner">
        <div>
            <h1 class="catalog-hero-title">Calculadora de Cuotas Fiao</h1>
            <p class="catalog-hero-sub">Simula tu financiamiento en segundos. Sin trámites, solo con tu cédula.</p>
        </div>
        <div class="catalog-hero-pills">
            <span class="catalog-pill">✓ Inicial desde 20%</span>
            <span class="catalog-pill">💳 3, 6 o 12 Meses</span>
            <span class="catalog-pill">⚡ Aprobación Inmediata</span>
        </div>
    </div>
</div>

<section class="page-section" style="background:var(--bg-page);">
    <div class="section-inner">

        <!-- TABS NAVIGATION -->
        <div class="cotizador-tabs">
            <button class="tab-button @(activeTab == "calculadora" ? "active" : "")" @onclick='() => activeTab = "calculadora"'>
                <i class="ph ph-calculator"></i> Calculadora
            </button>
            <button class="tab-button @(activeTab == "facturacion" ? "active" : "")" @onclick='() => activeTab = "facturacion"'>
                <i class="ph ph-receipt"></i> Facturación
            </button>
        </div>

        <!-- TAB CONTENT: CALCULADORA -->
        @if (activeTab == "calculadora")
        {
        <div class="cotizador-grid">

            <!-- LEFT: Calculator Form -->
            <div class="form-card">
                <span class="section-label">Tu Calculadora</span>
                <h2 class="section-title mb-6" style="font-size:1.5rem;">Configura tu Financiamiento</h2>

                <!-- Equipo -->
                <div class="form-group">
                    <label class="form-label">¿Qué equipo buscas?</label>
                    <select class="form-select-full" @bind="equipo" @bind:after="Calc">
                        <option value="0">Seleccionar equipo del catálogo…</option>
                        @foreach (var e in equipos)
                        {
                            <option value="@e.Precio">@e.Nombre – $@e.Precio.ToString("N0") RD$</option>
                        }
                    </select>
                </div>

                <!-- Precio -->
                <div class="form-group">
                    <label class="form-label">Precio del equipo (RD$)</label>
                    <div class="range-wrap mb-3">
                        <input type="range" class="range-slider"
                               min="10000" max="80000" step="500"
                               value="@precio"
                               @oninput='e => { precio = int.Parse(e.Value?.ToString() ?? "10000"); Calc(); }' />
                    </div>
                    <div class="flex items-center gap-3">
                        <input type="number" class="form-input" min="10000" max="80000"
                               @bind="precio" @bind:after="Calc" style="max-width:180px;" />
                        <span class="font-600 text-400" style="font-size:13.5px;">RD$ – Ajusta el slider arriba</span>
                    </div>
                </div>

                <!-- Porcentaje de inicial -->
                <div class="form-group">
                    <label class="form-label">Inicial: <strong>@pct%</strong> = $@((precio * pct / 100m).ToString("N0")) RD$</label>
                    <div class="term-chips">
                        @foreach (var p in new[] { 20, 30, 40, 50 })
                        {
                            <button class="term-chip @(pct == p ? "active" : "")" @onclick="() => { pct = p; Calc(); }">@p%</button>
                        }
                    </div>
                </div>

                <!-- Plazo -->
                <div class="form-group">
                    <label class="form-label">Plazo de financiamiento (meses)</label>
                    <div class="term-chips">
                        @foreach (var m in new[] { 3, 6, 9, 12 })
                        {
                            <button class="term-chip @(plazo == m ? "active" : "")" @onclick="() => { plazo = m; Calc(); }">@m meses</button>
                        }
                    </div>
                </div>

                <!-- Frecuencia -->
                <div class="form-group">
                    <label class="form-label">Frecuencia de pago</label>
                    <div class="flex gap-3">
                        <button class="term-chip flex-1 @(frec == "Quincenal" ? "active" : "")" @onclick='() => { frec = "Quincenal"; Calc(); }'>📅 Quincenal</button>
                        <button class="term-chip flex-1 @(frec == "Mensual" ? "active" : "")"   @onclick='() => { frec = "Mensual"; Calc(); }'>🗓️ Mensual</button>
                    </div>
                </div>

                <!-- Contact Form -->
                <hr style="border:none; border-top:1px solid var(--text-100); margin:28px 0;" />
                <p class="font-600 text-700 mb-4" style="font-size:14.5px;">¿Quieres que te llamemos? (Opcional)</p>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-input" placeholder="Tu nombre" @bind="nombre" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Teléfono</label>
                        <input type="tel" class="form-input" placeholder="809-XXX-XXXX" @bind="tel" />
                    </div>
                </div>

                <div class="form-check mb-5">
                    <input type="checkbox" class="form-check-box" id="acepto" @bind="acepto" />
                    <label class="form-check-label" for="acepto">
                        Acepto que Prodigio Tecnológico se comunique conmigo por WhatsApp para confirmar mi solicitud.
                    </label>
                </div>

                @if (enviado)
                {
                    <div class="alert-success">
                        <i class="ph ph-check-circle alert-success-icon"></i>
                        <div>
                            <h4>¡Solicitud enviada!</h4>
                            <p>Un asesor se pondrá en contacto contigo en los próximos 15 minutos por WhatsApp.</p>
                        </div>
                    </div>
                }

                <button class="btn btn-primary w-full" disabled="@(!acepto || string.IsNullOrWhiteSpace(nombre))" @onclick="Enviar">
                    <i class="ph ph-paper-plane-right"></i> Enviar solicitud de Financiamiento
                </button>
            </div>

            <!-- RIGHT: Results Card -->
            <div>
                <div class="result-card">
                    <p class="result-label">Tu cuota estimada @frec</p>
                    <div class="result-amount">$@cuota.ToString("N0") RD$</div>
                    <p class="result-period">por @(frec == "Quincenal" ? "quincena" : "mes") durante @plazo mes@(plazo != 1 ? "es" : "")</p>

                    <div class="result-divider"></div>

                    <div class="result-row">
                        <span>💰 Precio del equipo</span>
                        <strong>$@precio.ToString("N0") RD$</strong>
                    </div>
                    <div class="result-row">
                        <span>📥 Inicial (@pct%)</span>
                        <strong>$@inicial.ToString("N0") RD$</strong>
                    </div>
                    <div class="result-row">
                        <span>📋 Monto a financiar</span>
                        <strong>$@financiado.ToString("N0") RD$</strong>
                    </div>
                    <div class="result-row">
                        <span>💳 Plazo</span>
                        <strong>@plazo meses (@frec)</strong>
                    </div>
                    <div class="result-row">
                        <span>📅 Total de cuotas</span>
                        <strong>@totalCuotas pagos</strong>
                    </div>
                    <div class="result-row highlight">
                        <span><strong>🏷️ Total a pagar</strong></span>
                        <strong style="font-size:1.05rem;">$@totalPagar.ToString("N0") RD$</strong>
                    </div>

                    <div style="margin-top:24px; display:flex; flex-direction:column; gap:10px;">
                        <a href="https://wa.me/18095550199?text=Hola,%20quiero%20financiar%20un%20equipo%20de%20$@precio.ToString("N0")%20RD$%20a%20@plazo%20meses%20con%20inicial%20de%20@pct%25"
                           target="_blank" class="btn btn-wa" style="justify-content:center;">
                            <i class="ph ph-whatsapp-logo"></i> Confirmar por WhatsApp
                        </a>
                        <a href="/tienda" class="btn btn-outline" style="border-color:rgba(255,255,255,.2); color:rgba(255,255,255,.8); justify-content:center;">
                            <i class="ph ph-shopping-bag"></i> Ver catálogo
                        </a>
                    </div>

                    <div style="margin-top:20px; padding:14px; background:rgba(255,255,255,.08); border-radius:10px; font-size:12px; color:rgba(255,255,255,.6); line-height:1.6;">
                        ⓘ Simulación estimada. Las cuotas reales pueden variar según historial y condiciones Fiao. Aprobación sujeta a evaluación.
                    </div>
                </div>
            </div>

        </div>
        } <!-- FIN CALCULADORA TAB -->

        <!-- TAB CONTENT: FACTURACIÓN -->
        @if (activeTab == "facturacion")
        {
        <div class="cotizacion-form-wrapper">
            <div class="form-card">
                <span class="section-label">💼 Sistema de Facturación</span>
                <h2 class="section-title mb-6" style="font-size:1.5rem;">Gestión Profesional de Facturas</h2>

                <!-- SECTION 1: DATOS DEL CLIENTE -->
                <div class="factura-section">
                    <div class="factura-section-header">
                        <span class="section-number">1</span>
                        <h3>Datos del Cliente</h3>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Nombre del Cliente / Razón Social</label>
                            <input type="text" class="form-input" placeholder="Ej: Juan Pérez o Tech Solutions SRL" @bind="facturaClienteNombre" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">RNC / Cédula</label>
                            <input type="text" class="form-input" placeholder="Ej: 1-31-12345-6" @bind="facturaClienteRNC" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Correo Electrónico</label>
                            <input type="email" class="form-input" placeholder="cliente@correo.com" @bind="facturaClienteEmail" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Teléfono</label>
                            <input type="tel" class="form-input" placeholder="809-555-0101" @bind="facturaClienteTel" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Dirección</label>
                        <input type="text" class="form-input" placeholder="Av. Principal #123, Santo Domingo" @bind="facturaClienteDireccion" />
                    </div>
                </div>

                <!-- SECTION 2: DETALLES DEL COMPROBANTE -->
                <div class="factura-section">
                    <div class="factura-section-header">
                        <span class="section-number">2</span>
                        <h3>Detalles del Comprobante</h3>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Número de Factura</label>
                            <input type="text" class="form-input" readonly style="background: var(--sage-100); font-weight: bold; color: var(--sage-700); cursor: not-allowed;" @bind="numeroFactura" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Estado de Factura</label>
                            <select class="form-input">
                                <option>Borrador</option>
                                <option>Emitida</option>
                                <option>Pagada</option>
                                <option>Cancelada</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Fecha de Emisión</label>
                            <input type="date" class="form-input" @bind="fechaEmision" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Fecha de Vencimiento</label>
                            <input type="date" class="form-input" @bind="fechaVencimiento" />
                        </div>
                    </div>
                </div>

                <!-- SECTION 3: ARTÍCULOS / SERVICIOS -->
                <div class="factura-section">
                    <div class="factura-section-header-action">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="section-number">3</span>
                            <h3>Artículos / Servicios</h3>
                        </div>
                        <button type="button" class="btn-add-item" @onclick="AgregarItemFactura">
                            <i class="ph ph-plus-circle"></i> Agregar Artículo
                        </button>
                    </div>

                    <div class="items-table">
                        <div class="item-header">
                            <div class="col-desc">Descripción</div>
                            <div class="col-qty">Cant.</div>
                            <div class="col-price">Precio Unit.</div>
                            <div class="col-total">Total</div>
                            <div class="col-action"></div>
                        </div>
                        
                        @if (facturasItems.Count == 0)
                        {
                            <div style="padding: 20px; text-align: center; color: var(--text-400); font-style: italic;">
                                Haz clic en "Agregar Artículo" para comenzar
                            </div>
                        }
                        
                        @for (int i = 0; i < facturasItems.Count; i++)
                        {
                            var idx = i;
                            <div class="item-row" @key="idx">
                                <div class="col-desc">
                                    <input type="text" class="form-input" style="height: 38px;" placeholder="Ej: Reparación de pantalla iPhone 13" 
                                           @bind="facturasItems[idx].Descripcion" @bind:after="CalcularTotalesFactura" />
                                </div>
                                <div class="col-qty">
                                    <input type="number" class="form-input" style="height: 38px;" min="1" 
                                           @bind="facturasItems[idx].Cantidad" @bind:after="CalcularTotalesFactura" />
                                </div>
                                <div class="col-price">
                                    <input type="number" class="form-input" style="height: 38px;" step="0.01" min="0" 
                                           @bind="facturasItems[idx].PrecioUnitario" @bind:after="CalcularTotalesFactura" />
                                </div>
                                <div class="col-total">
                                    <span class="item-total">RD$ @facturasItems[idx].Subtotal.ToString("N2")</span>
                                </div>
                                <div class="col-action">
                                    <button type="button" class="btn-delete-item" @onclick="() => QuitarItemFactura(idx)" title="Eliminar">
                                        <i class="ph ph-trash-simple"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- TOTALES -->
                <div class="totales-factura">
                    <div class="total-item">
                        <span>Subtotal:</span>
                        <strong style="color: var(--text-600);">RD$ @SubtotalFactura.ToString("N2")</strong>
                    </div>
                    <div class="total-item">
                        <span>ITBIS (18%):</span>
                        <strong style="color: var(--text-600);">RD$ @ITBISFactura.ToString("N2")</strong>
                    </div>
                    <div class="total-item highlight-total">
                        <span><strong>Total General:</strong></span>
                        <strong style="font-size: 1.2rem;">RD$ @TotalFactura.ToString("N2")</strong>
                    </div>
                </div>

                <!-- NOTAS -->
                <div class="factura-section">
                    <div class="factura-section-header">
                        <span class="section-number">4</span>
                        <h3>Notas / Comentarios</h3>
                    </div>
                    <textarea class="form-input" style="height: 100px; resize: vertical; padding: 12px;" placeholder="Escribe notas de la factura aquí..." @bind="notasFactura"></textarea>
                </div>

                <!-- ACCIONES -->
                <div class="factura-actions">
                    <button type="button" class="btn btn-primary" @onclick="GuardarFactura">
                        <i class="ph ph-floppy-disk"></i> Guardar Factura
                    </button>
                    <button type="button" class="btn btn-success" @onclick="DescargarPdf">
                        <i class="ph ph-download"></i> Descargar PDF
                    </button>
                    <button type="button" class="btn btn-whatsapp" @onclick="EnviarPorWhatsApp">
                        <i class="ph ph-whatsapp-logo"></i> Enviar por WhatsApp
                    </button>
                </div>

                <!-- BOTÓN PROCEDER A LA COMPRA -->
                <button type="button" class="btn-proceed-checkout" @onclick="ProcederALaCompra">
                    <i class="ph ph-check-circle"></i> Proceder a la Compra
                </button>
            </div>
        </div>
        } <!-- FIN FACTURACIÓN TAB -->

    </div>
</section>

@code {
    // TAB MANAGEMENT
    private string activeTab = "calculadora";

    // CALCULADORA VARIABLES
    private decimal precio = 35000;
    private int pct = 30;
    private int plazo = 6;
    private string frec = "Mensual";
    private decimal equipo = 0;

    private string nombre = "";
    private string tel = "";
    private bool acepto = false;
    private bool enviado = false;

    // FACTURACIÓN VARIABLES
    private string facturaClienteNombre = "";
    private string facturaClienteRNC = "";
    private string facturaClienteEmail = "";
    private string facturaClienteTel = "";
    private string facturaClienteDireccion = "";
    
    private string numeroFactura = "";
    private DateTime fechaEmision = DateTime.Today;
    private DateTime fechaVencimiento = DateTime.Today.AddDays(30);
    private string notasFactura = "";
    
    private List<ItemFactura> facturasItems = new();

    private class ItemFactura
    {
        public string Descripcion { get; set; } = "";
        public decimal Cantidad { get; set; } = 1;
        public decimal PrecioUnitario { get; set; } = 0;
        public decimal Subtotal => Cantidad * PrecioUnitario;
    }

    // CALCULADORA COMPUTED PROPERTIES
    private decimal inicial => precio * pct / 100m;
    private decimal financiado => precio - inicial;
    private int totalCuotas => frec == "Quincenal" ? plazo * 2 : plazo;
    private decimal cuota => totalCuotas > 0 ? Math.Ceiling(financiado / totalCuotas) : 0;
    private decimal totalPagar => inicial + cuota * totalCuotas;

    // FACTURACIÓN COMPUTED PROPERTIES
    private decimal SubtotalFactura => facturasItems.Sum(a => a.Subtotal);
    private decimal ITBISFactura => SubtotalFactura * 0.18m;
    private decimal TotalFactura => SubtotalFactura + ITBISFactura;

    public record Modelo(string Nombre, int Precio);
    private List<Modelo> equipos = new()
    {
        new("iPhone 15 Pro Max (256GB)",   62500),
        new("iPhone 14 Pro (128GB)",       44900),
        new("iPhone 13 (128GB)",           29500),
        new("Samsung Galaxy S24 Ultra",    68000),
        new("Samsung Galaxy S23 FE",       28900),
        new("Tecno Camon 30 Pro 5G",      18500),
        new("Infinix Note 40 Pro 5G",     16500),
        new("Xiaomi 13T Pro (512GB)",      33000),
        new("Motorola Edge 40 Neo",        16800),
    };

    protected override void OnInitialized()
    {
        Calc();
        facturasItems.Add(new ItemFactura());
        numeroFactura = GenerarNumeroFactura();
    }

    private void Calc()
    {
        if (equipo > 0) precio = (int)equipo;
        if (precio < 10000) precio = 10000;
        if (precio > 80000) precio = 80000;
    }

    private void Enviar()
    {
        enviado = true;
    }

    // FACTURACIÓN METHODS
    private void AgregarItemFactura()
    {
        facturasItems.Add(new ItemFactura());
        StateHasChanged();
    }

    private void QuitarItemFactura(int index)
    {
        if (index >= 0 && index < facturasItems.Count)
        {
            if (facturasItems.Count > 1)
            {
                facturasItems.RemoveAt(index);
                CalcularTotalesFactura();
            }
            else
            {
                MostrarToastSync("Debe mantener al menos un artículo", "error");
            }
        }
    }

    private void CalcularTotalesFactura()
    {
        StateHasChanged();
    }

    // Versión síncrona de mostrar toast para métodos no-async
    private void MostrarToastSync(string message, string type = "info")
    {
        _ = MostrarToast(message, type);
    }

    // MÉTODOS DE FACTURACIÓN - ACCIONES
    private async Task GuardarFactura()
    {
        // Validar datos mínimos
        if (string.IsNullOrWhiteSpace(facturaClienteNombre) || facturasItems.Count == 0)
        {
            await MostrarToast("Completa los datos del cliente y agrega artículos", "error");
            return;
        }

        var itemsValidos = facturasItems.Where(i => !string.IsNullOrWhiteSpace(i.Descripcion)).ToList();
        if (itemsValidos.Count == 0)
        {
            await MostrarToast("Agrega al menos un artículo a la factura", "error");
            return;
        }

        await MostrarToast($"Factura {numeroFactura} guardada exitosamente ✓", "success");
        // Aquí iría la lógica para guardar en base de datos
    }

    private async Task DescargarPdf()
    {
        try
        {
            // Validar datos
            if (string.IsNullOrWhiteSpace(facturaClienteNombre) || facturasItems.Count == 0)
            {
                await MostrarToast("Completa los datos del cliente", "error");
                return;
            }

            // Preparar items para el PDF
            var itemsPdf = facturasItems
                .Where(i => !string.IsNullOrWhiteSpace(i.Descripcion))
                .ToList();

            if (itemsPdf.Count == 0)
            {
                await MostrarToast("Agrega al menos un artículo", "error");
                return;
            }

            // Preparar objeto factura para jsPDF
            var facturaPdf = new
            {
                numeroFactura = numeroFactura,
                clienteNombre = facturaClienteNombre,
                clienteRNC = facturaClienteRNC,
                clienteEmail = facturaClienteEmail,
                clienteTel = facturaClienteTel,
                clienteDireccion = facturaClienteDireccion,
                fechaEmision = fechaEmision.ToString("dd/MM/yyyy"),
                fechaVencimiento = fechaVencimiento.ToString("dd/MM/yyyy"),
                notas = notasFactura,
                items = itemsPdf.Select(i => new
                {
                    descripcion = i.Descripcion,
                    cantidad = i.Cantidad,
                    precioUnitario = i.PrecioUnitario
                }).ToList()
            };

            // Generar PDF con jsPDF
            await JsRuntime.InvokeVoidAsync("generarPdfFactura", facturaPdf);
            await MostrarToast("PDF generado y descargado ✓", "success");
        }
        catch (Exception ex)
        {
            await MostrarToast($"Error al generar PDF: {ex.Message}", "error");
        }
    }

    private async Task EnviarPorWhatsApp()
    {
        // Validar datos
        if (string.IsNullOrWhiteSpace(facturaClienteTel))
        {
            await MostrarToast("Agrega un número de teléfono para el cliente", "error");
            return;
        }

        var mensaje = $"Hola {facturaClienteNombre}, tu factura {numeroFactura} está lista. Total: RD$ {TotalFactura:N2}";
        var telefono = facturaClienteTel.Replace("-", "").Replace(" ", "");
        var url = $"https://wa.me/{telefono}?text=" + Uri.EscapeDataString(mensaje);
        
        await JsRuntime.InvokeVoidAsync("open", url, "_blank");
        await MostrarToast("Abriendo WhatsApp...", "info");
    }

    // Método auxiliar para mostrar toasts
    private async Task MostrarToast(string message, string type = "info")
    {
        await JsRuntime.InvokeVoidAsync("showToast", message, type);
    }

    // Generar número de factura único
    private string GenerarNumeroFactura()
    {
        return $"{DateTime.Now:yyyyMMdd}{new Random().Next(1000, 9999)}";
    }

    // PROCEDER A LA COMPRA - Validación integral
    private async Task ProcederALaCompra()
    {
        // Validar cliente
        if (string.IsNullOrWhiteSpace(facturaClienteNombre))
        {
            await MostrarToast("❌ Ingresa el nombre del cliente", "error");
            return;
        }

        if (string.IsNullOrWhiteSpace(facturaClienteRNC))
        {
            await MostrarToast("❌ Ingresa el RNC o Cédula del cliente", "error");
            return;
        }

        if (string.IsNullOrWhiteSpace(facturaClienteTel))
        {
            await MostrarToast("❌ Ingresa el teléfono del cliente", "error");
            return;
        }

        // Validar artículos
        if (facturasItems.Count == 0)
        {
            await MostrarToast("❌ Agrega al menos un artículo", "error");
            return;
        }

        var itemsValidos = facturasItems
            .Where(i => !string.IsNullOrWhiteSpace(i.Descripcion) && i.PrecioUnitario > 0)
            .ToList();

        if (itemsValidos.Count == 0)
        {
            await MostrarToast("❌ Todos los artículos deben tener descripción y precio", "error");
            return;
        }

        // Todo validado - Proceder
        await MostrarToast("✓ Procesando factura...", "info");
        
        // Guardar automáticamente
        await GuardarFactura();
        
        // Descargar PDF automáticamente
        await Task.Delay(500);
        await DescargarPdf();
    }
}
