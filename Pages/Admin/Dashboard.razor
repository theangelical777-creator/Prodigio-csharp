@page "/admin/dashboard"
@inject AuthService Auth
@inject ProdigioDatabaseService DbService
@inject NavigationManager Nav

<PageTitle>Dashboard Admin - Prodigio Tecnológico</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="login-overlay-fc">
        <div class="login-card-fc" style="text-align:center;">
            <h2 style="color:#F30C06;">⛔ Acceso Denegado</h2>
            <p style="color:#94a3b8;">Debes iniciar sesión para acceder al panel.</p>
            <button class="login-btn-fc" @onclick='() => Nav.NavigateTo("/login")'>
                Ir al Login
            </button>
        </div>
    </div>
}
else
{
    <div class="admin-dashboard-fc">
        <!-- Top Bar -->
        <div class="admin-topbar-fc">
            <div class="admin-topbar-left">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#49d6c3" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" rx="1"/>
                    <rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="3" y="14" width="7" height="7" rx="1"/>
                    <rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>
                <h1>Panel de Administración</h1>
            </div>
            <div class="admin-topbar-right">
                <a href="/" class="admin-link-fc" target="_blank">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                    Ver Sitio
                </a>
                <button class="admin-logout-btn-fc" @onclick="HandleLogout">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    Cerrar Sesión
                </button>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="admin-stats-row-fc">
            <div class="admin-stat-card-fc stat-cyan">
                <div class="stat-icon-fc">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="7" width="20" height="15" rx="2" ry="2"/>
                        <polyline points="17 2 12 7 7 2"/>
                    </svg>
                </div>
                <div class="stat-info-fc">
                    <span class="stat-number-fc">@inventario.Count</span>
                    <span class="stat-label-fc">Equipos en Catálogo</span>
                </div>
            </div>
            <div class="admin-stat-card-fc stat-green">
                <div class="stat-icon-fc">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                </div>
                <div class="stat-info-fc">
                    <span class="stat-number-fc">@inventario.Count(e => e.Disponible)</span>
                    <span class="stat-label-fc">Disponibles</span>
                </div>
            </div>
            <div class="admin-stat-card-fc stat-red">
                <div class="stat-icon-fc">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="1" x2="12" y2="23"/>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    </svg>
                </div>
                <div class="stat-info-fc">
                    <span class="stat-number-fc">@inventario.Sum(e => e.PrecioRD).ToString("N0")</span>
                    <span class="stat-label-fc">Valor Total RD$</span>
                </div>
            </div>
        </div>

        <!-- Inventory Table -->
        <div class="admin-table-section-fc">
            <div class="admin-table-header-fc">
                <h2>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#49d6c3" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    </svg>
                    Catálogo de Equipos
                </h2>
                <button class="admin-add-btn-fc" @onclick="ShowAddForm">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    Agregar Equipo
                </button>
            </div>

            @if (successMsg != "")
            {
                <div class="admin-success-msg-fc">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    @successMsg
                </div>
            }

            <div class="admin-table-responsive-fc">
                <table class="admin-table-fc">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Capacidad</th>
                            <th>Color</th>
                            <th>Estado</th>
                            <th>Precio RD$</th>
                            <th>Disponible</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var equipo in inventario)
                        {
                            <tr>
                                <td class="td-id">@equipo.Id</td>
                                <td>@equipo.Marca</td>
                                <td class="td-modelo">@equipo.Modelo</td>
                                <td>@equipo.Capacidad</td>
                                <td>@equipo.Color</td>
                                <td>
                                    <span class="admin-badge-fc @GetEstadoBadge(equipo.Estado)">@equipo.Estado</span>
                                </td>
                                <td class="td-precio">$@equipo.PrecioRD.ToString("N0")</td>
                                <td>
                                    @if (equipo.Disponible)
                                    {
                                        <span class="admin-badge-fc badge-green">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge-fc badge-red">No</span>
                                    }
                                </td>
                                <td class="td-actions">
                                    <button class="admin-edit-btn-fc" @onclick="() => ShowEditForm(equipo)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </button>
                                    <button class="admin-delete-btn-fc" @onclick="() => ConfirmDelete(equipo)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Modal: Add / Edit -->
        @if (showModal)
        {
            <div class="admin-modal-overlay-fc" @onclick="CloseModal">
                <div class="admin-modal-fc" @onclick:stopPropagation="true">
                    <div class="admin-modal-header-fc">
                        <h3>@(isEditing ? "Editar Equipo" : "Agregar Nuevo Equipo")</h3>
                        <button class="admin-modal-close-fc" @onclick="CloseModal">✕</button>
                    </div>
                    <div class="admin-modal-body-fc">
                        <div class="admin-form-grid-fc">
                            <div class="admin-form-group-fc">
                                <label>Marca</label>
                                <select @bind="formEquipo.Marca">
                                    <option value="">Seleccionar...</option>
                                    <option>Apple</option>
                                    <option>Samsung</option>
                                    <option>Xiaomi</option>
                                    <option>Google</option>
                                    <option>Motorola</option>
                                    <option>Huawei</option>
                                    <option>OnePlus</option>
                                </select>
                            </div>
                            <div class="admin-form-group-fc">
                                <label>Modelo</label>
                                <input type="text" @bind="formEquipo.Modelo" placeholder="Ej: iPhone 15 Pro Max" />
                            </div>
                            <div class="admin-form-group-fc">
                                <label>Capacidad</label>
                                <select @bind="formEquipo.Capacidad">
                                    <option>64 GB</option>
                                    <option>128 GB</option>
                                    <option>256 GB</option>
                                    <option>512 GB</option>
                                    <option>1 TB</option>
                                </select>
                            </div>
                            <div class="admin-form-group-fc">
                                <label>Color</label>
                                <input type="text" @bind="formEquipo.Color" placeholder="Ej: Titanio Natural" />
                            </div>
                            <div class="admin-form-group-fc">
                                <label>Estado</label>
                                <select @bind="formEquipo.Estado">
                                    <option>Sellado</option>
                                    <option>Como Nuevo</option>
                                    <option>Excelente</option>
                                    <option>Buen Estado</option>
                                </select>
                            </div>
                            <div class="admin-form-group-fc">
                                <label>Precio RD$</label>
                                <input type="number" @bind="formEquipo.PrecioRD" placeholder="Ej: 62500" />
                            </div>
                            <div class="admin-form-group-fc">
                                <label>Imagen (ruta)</label>
                                <input type="text" @bind="formEquipo.Imagen" placeholder="Ej: /iphone15promax.png" />
                            </div>
                            <div class="admin-form-group-fc">
                                <label>Año Lanzamiento</label>
                                <input type="number" @bind="formEquipo.AnioLanzamiento" />
                            </div>
                            <div class="admin-form-group-fc full-width">
                                <label class="admin-checkbox-fc">
                                    <input type="checkbox" @bind="formEquipo.Disponible" />
                                    <span>Disponible para la venta</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="admin-modal-footer-fc">
                        <button class="admin-cancel-btn-fc" @onclick="CloseModal">Cancelar</button>
                        <button class="admin-save-btn-fc" @onclick="SaveEquipo">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <polyline points="17 21 17 13 7 13 7 21"/>
                                <polyline points="7 3 7 8 15 8"/>
                            </svg>
                            @(isEditing ? "Guardar Cambios" : "Agregar Equipo")
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Modal: Delete Confirmation -->
        @if (showDeleteConfirm)
        {
            <div class="admin-modal-overlay-fc" @onclick="() => showDeleteConfirm = false">
                <div class="admin-modal-fc admin-modal-small-fc" @onclick:stopPropagation="true">
                    <div class="admin-modal-header-fc" style="border-color: rgba(243,12,6,0.3);">
                        <h3 style="color:#F30C06;">Confirmar Eliminación</h3>
                        <button class="admin-modal-close-fc" @onclick="() => showDeleteConfirm = false">✕</button>
                    </div>
                    <div class="admin-modal-body-fc" style="text-align:center; padding: 32px 24px;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#F30C06" stroke-width="1.5" style="margin-bottom:16px;">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                            <line x1="12" y1="9" x2="12" y2="13"/>
                            <line x1="12" y1="17" x2="12.01" y2="17"/>
                        </svg>
                        <p style="color:#e2e8f0; font-size:1rem; margin-bottom:8px;">
                            ¿Estás seguro de eliminar <strong style="color:#49d6c3;">@deleteTarget?.Modelo</strong>?
                        </p>
                        <p style="color:#64748b; font-size:0.85rem;">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="admin-modal-footer-fc">
                        <button class="admin-cancel-btn-fc" @onclick="() => showDeleteConfirm = false">Cancelar</button>
                        <button class="admin-delete-confirm-btn-fc" @onclick="DeleteEquipo">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"/>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                            </svg>
                            Sí, Eliminar
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<EquipoInventario> inventario = new();
    private EquipoInventario formEquipo = new();
    private EquipoInventario? deleteTarget;
    private bool showModal = false;
    private bool showDeleteConfirm = false;
    private bool isEditing = false;
    private string successMsg = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadInventario();
    }

    private async Task LoadInventario()
    {
        inventario = await DbService.ObtenerInventarioAsync();
    }

    private void ShowAddForm()
    {
        isEditing = false;
        formEquipo = new EquipoInventario { Disponible = true, Estado = "Como Nuevo", Capacidad = "128 GB", AnioLanzamiento = 2024 };
        showModal = true;
        successMsg = "";
    }

    private void ShowEditForm(EquipoInventario equipo)
    {
        isEditing = true;
        formEquipo = new EquipoInventario
        {
            Id = equipo.Id,
            Marca = equipo.Marca,
            Modelo = equipo.Modelo,
            Capacidad = equipo.Capacidad,
            Color = equipo.Color,
            Estado = equipo.Estado,
            PrecioRD = equipo.PrecioRD,
            Disponible = equipo.Disponible,
            Imagen = equipo.Imagen,
            AnioLanzamiento = equipo.AnioLanzamiento
        };
        showModal = true;
        successMsg = "";
    }

    private async Task SaveEquipo()
    {
        if (isEditing)
        {
            await DbService.ActualizarEquipoAsync(formEquipo);
            successMsg = $"✅ {formEquipo.Modelo} actualizado correctamente.";
        }
        else
        {
            await DbService.AgregarEquipoAsync(formEquipo);
            successMsg = $"✅ {formEquipo.Modelo} agregado al catálogo.";
        }

        await LoadInventario();
        showModal = false;
    }

    private void ConfirmDelete(EquipoInventario equipo)
    {
        deleteTarget = equipo;
        showDeleteConfirm = true;
        successMsg = "";
    }

    private async Task DeleteEquipo()
    {
        if (deleteTarget != null)
        {
            await DbService.EliminarEquipoAsync(deleteTarget.Id);
            successMsg = $"🗑️ {deleteTarget.Modelo} eliminado del catálogo.";
            await LoadInventario();
        }
        showDeleteConfirm = false;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private void HandleLogout()
    {
        Auth.Logout();
        Nav.NavigateTo("/login");
    }

    private string GetEstadoBadge(string estado) => estado switch
    {
        "Sellado" => "badge-cyan",
        "Como Nuevo" => "badge-green",
        "Excelente" => "badge-blue",
        "Buen Estado" => "badge-amber",
        _ => "badge-gray"
    };
}
