@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Admin Login - Prodigio Tecnológico</PageTitle>

<div class="login-overlay-fc">
    <div class="login-card-fc">
        <!-- Logo / Branding -->
        <div class="login-header-fc">
            <div class="login-logo-icon-fc">
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="4" y="8" width="24" height="36" rx="4" stroke="#49d6c3" stroke-width="2.5" fill="rgba(73,214,195,0.08)"/>
                    <rect x="8" y="14" width="16" height="20" rx="2" fill="rgba(73,214,195,0.15)" stroke="#49d6c3" stroke-width="1"/>
                    <circle cx="16" cy="40" r="2" fill="#49d6c3"/>
                    <path d="M32 16 L44 22 L44 38 L32 44 Z" fill="rgba(243,12,6,0.12)" stroke="#F30C06" stroke-width="2"/>
                    <path d="M36 26 L40 30 L36 34" stroke="#F30C06" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <h1>Prodigio Tecnológico</h1>
            <p class="login-subtitle-fc">Panel de Administración</p>
        </div>

        <!-- Error Alert -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="login-error-fc">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F30C06" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="15" y1="9" x2="9" y2="15"/>
                    <line x1="9" y1="9" x2="15" y2="15"/>
                </svg>
                <span>@errorMessage</span>
            </div>
        }

        <!-- Login Form -->
        <div class="login-form-fc">
            <div class="login-field-fc">
                <label for="username">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#49d6c3" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Usuario
                </label>
                <input type="text" id="username" @bind="username" @bind:event="oninput"
                       placeholder="Ingrese su usuario" autocomplete="username" />
            </div>

            <div class="login-field-fc">
                <label for="password">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#49d6c3" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    Contraseña
                </label>
                <input type="password" id="password" @bind="password" @bind:event="oninput"
                       @onkeypress="HandleKeyPress" placeholder="Ingrese su contraseña" autocomplete="current-password" />
            </div>

            <button class="login-btn-fc" @onclick="HandleLogin" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="login-spinner-fc"></span>
                    <span>Verificando...</span>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    <span>Iniciar Sesión</span>
                }
            </button>
        </div>

        <div class="login-footer-fc">
            <a href="/">← Volver al sitio público</a>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private bool isLoading = false;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/admin/dashboard");
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = "";
        isLoading = true;
        StateHasChanged();

        await Task.Delay(800); // Simular verificación

        if (Auth.Login(username, password))
        {
            Nav.NavigateTo("/admin/dashboard");
        }
        else
        {
            errorMessage = "Usuario o contraseña incorrectos. Intente de nuevo.";
            isLoading = false;
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }
}
