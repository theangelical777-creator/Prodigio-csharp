@page "/mision-vision"
@inject EmpresaInstitucionalService InstitucionalService
@inject IJSRuntime JS

<PageTitle>Misión, Visión y Valores - Prodigio Tecnológico</PageTitle>

<div class="mvv-page page-offset">
    <div class="mvv-hero fade-in">
        <span class="section-label">Propósito Institucional</span>
        <h1>Misión, Visión y Valores</h1>
        <p>
            Guiamos nuestras acciones diarias bajo pilares éticos y profesionales sólidos para ofrecer una experiencia tecnológica verdaderamente prodigiosa.
            <strong>@institucional.Lema</strong>
        </p>
    </div>

    <div class="mv-grid fade-in">
        <div class="mv-card mision">
            <div class="mv-card-icon">
                <i class="ph ph-target"></i>
            </div>
            <h2>Nuestra Misión</h2>
            <p>@institucional.Mision</p>
        </div>

        <div class="mv-card vision">
            <div class="mv-card-icon">
                <i class="ph ph-eye"></i>
            </div>
            <h2>Nuestra Visión</h2>
            <p>@institucional.Vision</p>
        </div>
    </div>

    <div class="section-header mt-6 fade-in">
        <div class="section-title">
            <h2>Nuestros Valores</h2>
            <p>Los principios que definen nuestra cultura organizacional</p>
        </div>
    </div>

    <div class="values-grid fade-in">
        @foreach (var valor in institucional.Valores)
        {
            <div class="value-card">
                <span class="value-emoji">@valor.Emoji</span>
                <h3>@valor.Nombre</h3>
                <p>@valor.Descripcion</p>
            </div>
        }
    </div>

    <div class="code-section fade-in">
        <div class="code-section-header">
            <div>
                <span class="section-label">Implementación en C#</span>
                <h2>Código fuente del módulo</h2>
                <p class="code-section-desc">
                    Misión, visión y valores definidos como modelos y servicios en Blazor WebAssembly.
                </p>
            </div>
            <button class="btn btn-outline btn-sm code-copy-btn" @onclick="CopiarCodigo">
                <i class="ph ph-copy"></i> @(copiado ? "¡Copiado!" : "Copiar código")
            </button>
        </div>
        <div class="code-block-wrapper">
            <pre class="code-block"><code>@codigoFuente</code></pre>
        </div>
    </div>

    <div class="mvv-cta fade-in">
        <h3>¿Quieres conocer más sobre Prodigio?</h3>
        <p>Descubre nuestra historia, servicios y el equipo que hace posible nuestra misión.</p>
        <div class="flex gap-3" style="justify-content: center; flex-wrap: wrap;">
            <a href="nosotros" class="btn btn-primary">Quiénes Somos</a>
            <a href="contacto" class="btn btn-outline">Contáctanos</a>
        </div>
    </div>
</div>

@code {
    private EmpresaInstitucional institucional = new();
    private string codigoFuente = string.Empty;
    private bool copiado;

    protected override void OnInitialized()
    {
        institucional = InstitucionalService.Obtener();
        codigoFuente = InstitucionalService.ObtenerCodigoFuente();
    }

    private async Task CopiarCodigo()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", codigoFuente);
        copiado = true;
        StateHasChanged();
        await Task.Delay(2000);
        copiado = false;
        StateHasChanged();
    }
}
